# Required: bearer token for the agent API (/agent/*). Generate a unique value:
#   openssl rand -hex 32
AGENT_API_TOKEN=

# Optional: bearer token the process runtime must present on /uapf/host/*.
# Leave empty only when the agent and the runtime share a private network.
AGENT_HOST_TOKEN=

# LLM gateway credential (OpenAI-compatible endpoint)
LLM_API_KEY=

# Credentials for MCP servers named in config/agent.yaml (systems.servers.*.authEnv)
DMS_MCP_TOKEN=
